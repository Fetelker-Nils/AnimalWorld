{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/spielinfo.html",
      "destination": "/hilfe",
      "permanent": true
    },
    {
      "source": "/spielhilfe.html",
      "destination": "/hilfe",
      "permanent": true
    },
    {
      "source": "/spielinfo",
      "destination": "/hilfe",
      "permanent": true
    },
    {
      "source": "/spielhilfe",
      "destination": "/hilfe",
      "permanent": true
    },
    {
      "source": "/hilfe/",
      "destination": "/hilfe",
      "permanent": true
    },
    {
      "source": "/welt.html",
      "destination": "/welt",
      "permanent": true
    },
    {
      "source": "/welt/",
      "destination": "/welt",
      "permanent": true
    },
    {
      "source": "/fahrplan.html",
      "destination": "/fahrplan",
      "permanent": true
    },
    {
      "source": "/fahrplan/",
      "destination": "/fahrplan",
      "permanent": true
    },
    {
      "source": "/neuigkeiten.html",
      "destination": "/neuigkeiten",
      "permanent": true
    },
    {
      "source": "/neuigkeiten/",
      "destination": "/neuigkeiten",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/hilfe",
      "destination": "/spielinfo.html"
    },
    {
      "source": "/welt",
      "destination": "/welt.html"
    },
    {
      "source": "/fahrplan",
      "destination": "/fahrplan.html"
    },
    {
      "source": "/neuigkeiten",
      "destination": "/neuigkeiten.html"
    }
  ]
}
